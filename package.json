{
  "name": "journal-kmk",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*", "server"],
  "scripts": {
    "dev:server": "npm --workspace server run dev",
    "dev:desktop": "npm --workspace apps/desktop run dev",
    "build": "npm run build:shared && npm run build:server && npm run build:desktop",
    "build:shared": "npm --workspace packages/shared run build",
    "build:server": "npm --workspace server run build",
    "build:desktop": "npm --workspace apps/desktop run build",
    "test": "npm --workspace server test"
  }
}